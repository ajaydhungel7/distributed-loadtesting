          { "matcher": { "id": "byName", "options": "errorRate" }, "properties": [{ "id": "unit", "value": "percentunit" }] },
          { "matcher": { "id": "byName", "options": "throughput" }, "properties": [{ "id": "unit", "value": "reqps" }] }
        ]
      },
