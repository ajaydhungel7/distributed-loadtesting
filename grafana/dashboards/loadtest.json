          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "alias": "active VUs",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "testId": "$testId" },
          "metricName": "activeVUs",
          "namespace": "LoadTest",
          "period": "15",
          "refId": "A",
          "region": "default",
          "statistic": "Maximum"
        }
      ],
      "title": "Active Virtual Users",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
