{
  "__inputs": [],
  "__requires": [
    {
      "type": "datasource",
      "id": "cloudwatch",
      "name": "CloudWatch",
      "version": "1.0.0"
    }
  ],
  "annotations": { "list": [] },
  "description": "Distributed Queue Autoscaling Platform — job metrics and queue depth",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Queue Depth",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Number of messages waiting in the target queue — the key autoscaling signal",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "alias": "Queue Depth",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "QueueName": "loadtest-target" },
          "matchExact": true,
          "metricName": "ApproximateNumberOfMessagesVisible",
          "namespace": "AWS/SQS",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Maximum"
        }
      ],
      "title": "Target Queue Depth",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Worker Scaling",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Number of running ECS worker tasks — shows autoscaler responding to queue depth",
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "orange", "mode": "fixed" }, "custom": { "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "alias": "Running Workers",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "ClusterName": "loadtest", "ServiceName": "WorkerStack-WorkerService*" },
          "matchExact": false,
          "metricName": "RunningTaskCount",
          "namespace": "ECS/ContainerInsights",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Maximum"
        }
      ],
      "title": "Active Worker Count",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Publish Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Messages published to the target queue per second (from SQS NumberOfMessagesSent)",
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "custom": { "lineWidth": 2 }, "unit": "mps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "alias": "Sent/s",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "QueueName": "loadtest-target" },
          "matchExact": true,
          "metricName": "NumberOfMessagesSent",
          "namespace": "AWS/SQS",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        }
      ],
      "title": "Messages Sent/min",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Age of the oldest unprocessed message — shows consumer lag",
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "custom": { "lineWidth": 2 }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "alias": "Oldest Message Age",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "QueueName": "loadtest-target" },
          "matchExact": true,
          "metricName": "ApproximateAgeOfOldestMessage",
          "namespace": "AWS/SQS",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Maximum"
        }
      ],
      "title": "Consumer Lag (oldest message age)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Job Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Total messages successfully sent by all workers for this job",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 28 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "alias": "total sent",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "jobId": "$jobId" },
          "matchExact": false,
          "metricName": "totalSent",
          "namespace": "QueueScaling",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        }
      ],
      "title": "Total Messages Sent",
      "type": "stat"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Total messages that failed to publish",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 28 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "alias": "total failed",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "jobId": "$jobId" },
          "matchExact": false,
          "metricName": "totalFailed",
          "namespace": "QueueScaling",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        }
      ],
      "title": "Total Messages Failed",
      "type": "stat"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "Aggregate publish rate across all workers",
      "fieldConfig": { "defaults": { "unit": "mps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 28 },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "alias": "throughput",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "jobId": "$jobId" },
          "matchExact": false,
          "metricName": "throughput",
          "namespace": "QueueScaling",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Sum"
        }
      ],
      "title": "Publish Throughput (msg/s)",
      "type": "stat"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "description": "How long the job took to publish all messages",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 28 },
      "id": 8,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["max"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "alias": "duration",
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "jobId": "$jobId" },
          "matchExact": false,
          "metricName": "durationSeconds",
          "namespace": "QueueScaling",
          "period": "60",
          "refId": "A",
          "region": "default",
          "statistic": "Maximum"
        }
      ],
      "title": "Job Duration (s)",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["queue", "autoscaling", "distributed"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
        "definition": "",
        "hide": 0,
        "includeAll": false,
        "label": "Job ID",
        "multi": false,
        "name": "jobId",
        "options": [],
        "query": {
          "dimensionFilters": {},
          "dimensionKey": "jobId",
          "metricName": "totalSent",
          "namespace": "QueueScaling",
          "queryType": "dimensionValues",
          "region": "default"
        },
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Distributed Queue Autoscaling Platform",
  "uid": "queue-autoscaling",
  "version": 1
}
